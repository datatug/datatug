{
  "format": "private-architecture-handoff/1",
  "round": 1,
  "status": "proposed-needs-independent-review",
  "review_scope": "runtime/product architecture; no semantic equivalence decisions",
  "prepared_date": "2026-10-05",
  "runtime": "localCodex",
  "host": "macOS",
  "authorization_limits": [
    "no repository source edits",
    "no cloud mutations",
    "no credential inspection",
    "no BigQuery jobs",
    "no billing changes",
    "no inferred execution principal"
  ],
  "preserved_lanes": [
    "W1 GeoNames/ROR app and publisher",
    "ECB FX priority",
    "credible research backlog"
  ],
  "decisions": [
    {
      "id": "implementation-home",
      "decision": "Port dal-go/dalgo-http-adapters/packages/bigquery; do not unarchive dalgo2bigquery-js",
      "repository": "https://github.com/dal-go/dalgo-http-adapters",
      "revision": "a3b35d251ff002e830e865c6a330ef6149ecf340",
      "archive_reason": "unknown"
    },
    {
      "id": "compatibility",
      "decision": "Maintain app core pin; test port against exact 0.2 and 0.3 core revisions; transport/result-set entry independent of keyed core runtime where practical",
      "app_core_pin": "1534acd4d0e4a104c58eba09fb9c25619efc8f24",
      "current_core_main": "04a7f1293ad57a50a282ecc13314ce7b1488211e"
    },
    {
      "id": "execution",
      "decision": "Browser-direct HTTPS to fixed Google origin with user-selected execution principal and job project; source project/dataset/table/location separate"
    },
    {
      "id": "auth",
      "decision": "Reuse explicit Sneat/Firebase DataTug sign-in/signup and user-record init; separate GIS incremental OAuth authorization; no Firebase ID token sent to BigQuery"
    },
    {
      "id": "scope-cancel",
      "decision": "bigquery.readonly default supports Stop waiting; optional explicit bigquery consent enables best-effort remote cancellation and final status verification; no cloud-platform convenience scope"
    },
    {
      "id": "resultset",
      "decision": "Analytical job/result-set API for tables without proven unique keys; keyed reads optional only with verified non-null unique key; no invented identity"
    },
    {
      "id": "cost",
      "decision": "Exact dry-run preview plus mandatory maximumBytesBilled; user-approved project/principal/cap; bounded results/pages/bytes and cumulative in-app reservation; no silent query replay"
    },
    {
      "id": "ovdb",
      "decision": "New narrowly versioned source-access profile in existing canonical OVDB descriptor/discovery family; schema/Directory propagation required; exact wire version determined by implementation review; no parallel registry"
    },
    {
      "id": "proof",
      "decision": "Live warehouse observation and job-result receipt separate from immutable SQLite/native format 3/4 proofs; no semantic admission implied"
    },
    {
      "id": "dataset",
      "decision": "Citi Bike stays prioritized but admission blocked on exact metadata and use-specific rights; reviewed official sample may prove transport only; preserve underlying candidate/access-route reconciliation"
    },
    {
      "id": "backend",
      "decision": "Existing app registration and metadata publication only; no query proxy or Go adapter necessary for this slice; shared funded execution requires separate broker/budget design"
    }
  ],
  "journey": [
    {
      "id": 1,
      "step": "Browse catalog",
      "observable_gate": "No login/query/account creation; truthful candidate/readiness metadata"
    },
    {
      "id": 2,
      "step": "Run and DataTug signup/signin",
      "observable_gate": "Explicit signup disclosure, successful existing user profile init, preserved draft"
    },
    {
      "id": 3,
      "step": "Connect Google execution identity",
      "observable_gate": "Granted read-only scope and verified execution account; recovery on denied/expired grants"
    },
    {
      "id": 4,
      "step": "Select execution project",
      "observable_gate": "Metadata/dry-run access succeeds; no-project detour retains draft"
    },
    {
      "id": 5,
      "step": "Preview and approve cap",
      "observable_gate": "Exact plan/parameters/source/location/principal/project and cap approved; execution changed inputs invalidate preview"
    },
    {
      "id": 6,
      "step": "View and page results",
      "observable_gate": "Exact typed values and same-job paging with visible provenance and incompleteness"
    },
    {
      "id": 7,
      "step": "Stop or cancel",
      "observable_gate": "Local stop distinguished from consented remote cancel and terminal status"
    },
    {
      "id": 8,
      "step": "Resume",
      "observable_gate": "Same execution identity/job where available; expiration demands explicit rerun"
    }
  ],
  "implementation_stages": [
    {
      "id": "A",
      "scope": "Monorepo adapter port and fixture tests",
      "gates": [
        "source != job project",
        "exact scalar wire/parameters",
        "byte/page bounds",
        "unknown submission behavior",
        "partial scope and cancellation states",
        "both core revision compatibility",
        "app pin unchanged"
      ]
    },
    {
      "id": "B",
      "scope": "OVDB descriptor/discovery profile and Directory propagation",
      "gates": [
        "closed discriminator validation",
        "legacy immutable profiles unchanged",
        "no fake execution API",
        "credentials absent",
        "transport gives no semantics"
      ]
    },
    {
      "id": "C",
      "scope": "DataTug auth/project/cost/query/grid flow",
      "gates": [
        "browse anonymous",
        "explicit signup at Run",
        "draft persistence",
        "no-project/denial/expiry recovery",
        "zoneless no-extra-click journey",
        "W1 regression checks"
      ]
    },
    {
      "id": "D",
      "scope": "Deployed real browser smoke",
      "requires_human": [
        "OAuth consent",
        "explicit execution identity",
        "eligible project",
        "concrete capped execution approval"
      ],
      "gates": [
        "real origin CORS",
        "source metadata",
        "dry run",
        "capped execution",
        "two same-job pages",
        "truthful stop",
        "real cancel call if broader consent exists",
        "sanitized exact deploy and job receipts"
      ]
    },
    {
      "id": "E",
      "scope": "First useful source admission",
      "gates": [
        "exact tables/dataset metadata",
        "rights and cache/export policy",
        "independent candidate-route reconciliation",
        "independent semantics if joins",
        "canonical publication",
        "actual DataTug query",
        "independent adversarial acceptance",
        "remote landing/deploy receipts and cleanup"
      ]
    }
  ],
  "conditional_product_questions": [
    {
      "question": "Must every connection support immediate remote cancellation?",
      "default": "Read-only consent plus Stop waiting, optional broader cancellation consent",
      "reason": "Mandatory cancellation requires broader scope and verification/consent tradeoff"
    },
    {
      "question": "Must users with no Google project execute without setup?",
      "default": "User-controlled sandbox/project setup detour",
      "reason": "Company-funded alternative needs explicit cost ownership and a server enforcement boundary"
    }
  ],
  "discovery_review_findings": [
    {
      "id": "B1",
      "severity": "blocking",
      "summary": "Current adapter lacks or does not verify required source/job split, dry run/cap and deployed OAuth/CORS/IAM/job/type gates",
      "disposition": "Address A,C,D before live feature claim"
    },
    {
      "id": "B2",
      "severity": "blocking",
      "summary": "Current OVDB profiles cannot truthfully model browser-owned external warehouse execution",
      "disposition": "Address B before canonical product admission"
    },
    {
      "id": "M1",
      "severity": "major",
      "summary": "Maintained monorepo package omitted from discovery recommendation",
      "disposition": "Corrected to reuse packages/bigquery"
    },
    {
      "id": "M2",
      "severity": "major",
      "summary": "Citi Bike table aliases and licence suitability unresolved",
      "disposition": "Retain source-specific gate; do not admit"
    },
    {
      "id": "M3",
      "severity": "major",
      "summary": "JS numeric decimal parameters, unbounded body reading and current paging contract are unsafe to reuse unchanged",
      "disposition": "Explicit exactness, response bounds and same-job contract in A"
    },
    {
      "id": "M4",
      "severity": "major",
      "summary": "String search absence cannot establish underlying dataset absence",
      "disposition": "Fresh independent access-route reconciliation in existing hub; no semantic claims"
    }
  ],
  "limits": [
    "No executed tests in this architecture-only turn",
    "No browser/OAuth/CORS/IAM proof",
    "No source dataset admitted",
    "No current production OAuth configuration verified",
    "Exact shipped Sneat package artifact still to verify",
    "No CI/deployment conclusion",
    "No independent review of this newly authored proposal yet",
    "Hub 691/1177 counts parent-provided, not reverified"
  ],
